post_install() {
  cat <<'EOF'
==> This package is only the binary. For each user, install the shell
    plugin from the Omarchy plugin marketplace and set omaskpass up:
      omarchy plugin add https://github.com/lbssousa/omaskpass.git --enable
      mkdir -p ~/.config/environment.d
      printf 'SSH_ASKPASS=/usr/bin/omaskpass\nSSH_ASKPASS_REQUIRE=prefer\n' > ~/.config/environment.d/90-ssh-askpass.conf
    then log in again.
EOF
}

post_upgrade() {
  echo '==> Update the shell plugin too: omarchy plugin update lbssousa.omaskpass'
}
