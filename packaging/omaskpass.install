post_install() {
  cat <<'EOF'
==> The shell plugin is not enabled per user automatically. For each user:
      ln -sfn /usr/share/omaskpass/plugin ~/.config/omarchy/plugins/lbssousa.omaskpass
      omarchy-shell shell enablePlugin lbssousa.omaskpass '{}'
      mkdir -p ~/.config/environment.d
      printf 'SSH_ASKPASS=/usr/bin/omaskpass\nSSH_ASKPASS_REQUIRE=prefer\n' > ~/.config/environment.d/90-ssh-askpass.conf
    then log in again.
EOF
}

post_upgrade() {
  echo '==> Restart the shell (omarchy-restart-shell) to load the updated dialog.'
}
